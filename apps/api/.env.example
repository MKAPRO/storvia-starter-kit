APP_NAME=STORVIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: set APP_URL to the public API origin, e.g. https://api.example.com.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storvia
DB_USERNAME=root
DB_PASSWORD=

# Required for initial setup mutations until setup is completed.
# Generate a strong random value and keep it outside source control.
STORVIA_SETUP_TOKEN=

# Optional Starter demo dataset. Disabled by default.
# Never commit a real password. Demo seeding refuses production and requires
# a strong password supplied only through the local/deployment environment.
STORVIA_STARTER_DEMO_SEED=false
STORVIA_STARTER_DEMO_PASSWORD=

# First-party SPA security baseline.
# SANCTUM_STATEFUL_DOMAINS contains host[:port] entries without scheme.
# CORS_ALLOWED_ORIGINS contains full browser origins with scheme.
# Production example:
# SANCTUM_STATEFUL_DOMAINS=app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=storvia_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Production HTTPS deployments must set SESSION_SECURE_COOKIE=true.

BROADCAST_CONNECTION=log
# Laravel framework default disk. STORVIA file objects resolve their disk from
# installation_settings.storage_disk and currently allow only the private local disk.
FILESYSTEM_DISK=local
STORVIA_UPLOAD_MAX_KILOBYTES=102400
STORVIA_UPLOAD_MAX_FILES_PER_BATCH=10
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverse proxy / load balancer hardening.
# Leave TRUSTED_PROXIES and TRUSTED_HOSTS empty for direct localhost/XAMPP use.
# Production: list only the exact proxy IPs/CIDRs that connect directly to Laravel.
# Examples: TRUSTED_PROXIES=10.0.0.10 or TRUSTED_PROXIES=10.0.0.0/24,192.168.50.10
# Catch-all values (*, **, 0.0.0.0/0, ::/0) are rejected by STORVIA.
TRUSTED_PROXIES=
# x-forwarded trusts X-Forwarded-For / Proto / Port, but never X-Forwarded-Host.
# Use aws-elb only behind AWS ELB/ALB-compatible X-Forwarded headers.
TRUSTED_PROXY_HEADER_PROFILE=x-forwarded
# Exact public API hostnames only. No scheme, port, path, or wildcard syntax.
# Production example: TRUSTED_HOSTS=api.example.com
TRUSTED_HOSTS=

# Browser transport-security hardening.
# Keep disabled for localhost/development. Enable only after the public HTTPS deployment is verified.
# HSTS is emitted by Laravel only for secure production requests.
STORVIA_HSTS_ENABLED=false
STORVIA_HSTS_MAX_AGE=31536000
# Enable only if every current and future subdomain is HTTPS-only.
STORVIA_HSTS_INCLUDE_SUBDOMAINS=false
