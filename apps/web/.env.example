# Public Laravel API origin used by the browser.
# Local development:
NEXT_PUBLIC_STORVIA_API_URL=http://localhost:8000

# Production builds MUST override this with the deployed API origin, for example:
# NEXT_PUBLIC_STORVIA_API_URL=https://api.example.com

# Browser transport-security hardening.
# Keep disabled for localhost/development. Enable only for a verified HTTPS production deployment.
STORVIA_HSTS_ENABLED=false
STORVIA_HSTS_MAX_AGE=31536000
# Enable only if every current and future subdomain is HTTPS-only.
STORVIA_HSTS_INCLUDE_SUBDOMAINS=false
